# Cal.com — public booking link path (no leading slash, no host).
# Used by <BookCallButton /> on /platform, /leasing/*, post-calculator.
# When unset, the booking button falls back to the static contact link.
NEXT_PUBLIC_CAL_LINK=your-cal-handle/30min
# Cal.com server-only API key (for future server-side use, e.g. drip
# pause-on-reply). Not required for the embed.
CAL_API_KEY=cal_live_...
